# Copy this file to ".env" and fill in what you need.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (default: SQLite, no setup needed) ---
# Options: sqlite | postgres | mysql
DB_ENGINE=sqlite
DB_NAME=studyhelper
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=

# --- APIs ---
# YouTube Data API v3 key (REQUIRED for the Videos search; free quota)
YOUTUBE_API_KEY=
# Google Books key (OPTIONAL - works without one, key just raises your quota)
GOOGLE_BOOKS_API_KEY=
# Dictionary (dictionaryapi.dev), Open-Meteo (weather) and ZenQuotes need NO key.
DEFAULT_CITY=Manila

# --- Email for "Forgot password" ---
# Default prints the reset link in the terminal (perfect for development).
# For real emails (e.g. Gmail), set these:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
